  "config": {
    "joint_protocol": {
      "schema_version": 1,
      "stage": "5_minimal_joint_pose_sparse_structure_refinement",
      "input": "immutable weighted fusion grid, same eligible COLMAP point IDs and actual measured tracks; raw point/camera priors",
      "fusion_rule_sha256": "f6e146b5a87659af6e3fb20d717b45be2b7531034c75f2d43830f095ac1b1c5b",
      "scope": "jointly optimize relative camera poses and one shared 3D point per eligible COLMAP track; write shared points only to previously eligible grid positions; no dense propagation, new matching, intrinsic fitting or training",
      "gauge": "first raw pose fixed exactly; raw/anchor XYZ priors fix arbitrary scale and world frame; all remaining poses regularized",
      "normalization": "median positive source-camera raw Z over previously eligible anchor grid points; no GT",
      "candidate_pose_prior_strengths": [
        1.0,
        10.0
      ],
      "residuals": {
        "reprojection_sigma_native_px": 2.0,
        "raw_xyz_sigma_over_depth": 0.01,
        "classical_xyz_sigma_over_depth": 0.01,
        "pose_rotation_sigma_deg": 0.5,
        "pose_translation_sigma_over_depth": 0.005,
        "raw_prior_weight": "same w_raw as fusion per grid point",
        "classical_prior_weight": "one alpha*w_col per unique COLMAP point; alpha frozen fusion strength; duplicate observations do not duplicate this prior",
        "reprojection_weight": "w_col per actual track observation; measured uv mapped to raw native pixel centers",
        "robust_loss": "soft_l1 f_scale=1 applied to all normalized scalar residuals",
        "cheirality": "soft barrier z>=0.0001*normalization with sigma=0.001*normalization; reject output with any nonpositive observation Z"
      },
      "solver": {
        "method": "scipy least_squares trf, sparse two-point Jacobian and lsmr",
        "max_nfev": 60,
        "wall_budget_seconds": 20.0,
