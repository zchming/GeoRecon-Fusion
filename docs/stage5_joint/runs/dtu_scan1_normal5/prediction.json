        "pose_translation_sigma_over_depth": 0.005,
        "raw_prior_weight": "same w_raw as fusion per grid point",
        "classical_prior_weight": "one alpha*w_col per unique COLMAP point; alpha frozen fusion strength; duplicate observations do not duplicate this prior",
        "reprojection_weight": "w_col per actual track observation; measured uv mapped to raw native pixel centers",
        "robust_loss": "soft_l1 f_scale=1 applied to all normalized scalar residuals",
        "cheirality": "soft barrier z>=0.0001*normalization with sigma=0.001*normalization; reject output with any nonpositive observation Z"
